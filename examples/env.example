# Environment-only configuration (no YAML needed). Copy to .env for
# docker compose, or pass with `docker run --env-file`.
# Variables override values from the YAML file when both are used.

MPS_LOG_FORMAT=zorp
MPS_LOG_LEVEL=info

MPS_MQTT_BROKER=tcp://[2001:db8:0:10::5]:1883
MPS_MQTT_USERNAME=presence
MPS_MQTT_PASSWORD=change-me

MPS_PRESENCE_CONSIDER_HOME=3m

MPS_DEFAULTS_TRANSPORT=rest
MPS_DEFAULTS_REST_USERNAME=presence
MPS_DEFAULTS_REST_PASSWORD=change-me
MPS_DEFAULTS_REST_INSECURE_SKIP_VERIFY=true

MPS_DEVICES_0_NAME=ap-living-room
MPS_DEVICES_0_HOST=2001:db8:0:10::2

MPS_DEVICES_1_NAME=core-router
MPS_DEVICES_1_HOST=2001:db8:0:10::1
MPS_DEVICES_1_KINDS=neighbor,arp,dhcp

MPS_DEVICES_2_NAME=switch-office
MPS_DEVICES_2_HOST=2001:db8:0:10::3
MPS_DEVICES_2_TRANSPORT=snmp
MPS_DEVICES_2_KINDS=bridge_host
MPS_DEVICES_2_SNMP_VERSION=2c
MPS_DEVICES_2_SNMP_COMMUNITY=change-me

MPS_PEOPLE_0_ID=alice
MPS_PEOPLE_0_NAME=Alice
MPS_PEOPLE_0_MACS=AA:BB:CC:00:00:01

MPS_PEOPLE_1_ID=bob
MPS_PEOPLE_1_NAME=Bob
MPS_PEOPLE_1_MACS=AA:BB:CC:00:00:02,AA:BB:CC:00:00:03
